# Copy this file to .env and fill in real values. .env is git-ignored.
# NEVER put a real key in this file — it is committed to the repository.

# GEMINI_API_KEY: required for live model responses.
# Without it ANGEL still runs, but only on the offline core (exact finance
# calculations + document retrieval, no open-ended conversation).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# APP_URL: the URL this app is hosted at, used for self-referential links.
APP_URL=

# GOLDAPI_KEY (optional): GoldAPI.io key for live spot metal prices.
# Without it the app falls back to the free public spot feed.
GOLDAPI_KEY=
